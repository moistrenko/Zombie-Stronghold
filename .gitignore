# Godot 4 generated files
.godot/
*.translation

# Export / secrets
export_credentials.cfg
*.keystore
*.jks
*.p12
*.mobileprovision
*.pem

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
*.tmp

# Imports (regenerated by editor; keep .import next to assets if team prefers)
# Uncomment if you do not commit .import files:
# *.import

# Builds artifacts; keep builds/.gdignore tracked so Godot skips the folder
builds/*
!builds/.gdignore
dist/
*.apk
*.aab
*.ipa
*.xcframework

# Android Gradle build template (Project → Install Android Build Template
# or: godot --install-android-build-template). Heavy; regenerate locally.
# Keep android/.build_version tracked (Godot version pin for AAB).
# See docs/stage18_android_aab.md
android/build/
android/.generated/
