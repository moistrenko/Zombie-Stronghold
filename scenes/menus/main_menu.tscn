[node name="HowBody" type="Label" parent="HowToOverlay/Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 22
text = "• Portrait-first: hold the phone upright.
• Infinite waves — survive as long as you can; wall HP ≤ 0 = defeat.
• Bottom bar: pick a defense (icon + price). Ghost follows; tap the zone to place.
• Tap (i) on a type for stats. Tap a placed unit for Sell / Upgrade.
• Turrets & Support on the fortress wall top; mines & fences on the approach path.
• Zombies shuffle slowly, then chew the gate for 1 HP per hit.
• REPAIR / SLOW abilities (left side) — cooldowns + Repair charges.
• Pause → RETIRE to cash out Stars anytime; defeat also awards Stars by wave.
• Spend Stars in META SHOP (Build Cost −10% replaces old max-turrets)."
autowrap_mode = 3

